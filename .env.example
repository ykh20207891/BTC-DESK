# Copy this file to .env — it is read only by the Python engine and never shown in the UI.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = testnet endpoints, false = mainnet
BYBIT_TESTNET=false
# paper = simulated fills on real mainnet data (default). live = real orders (needs keys + explicit switch in the UI).
TRADING_MODE=paper
# Starting balance for the paper ledger (USDT)
PAPER_SEED_EQUITY=10000
HOST=127.0.0.1
PORT=8765
